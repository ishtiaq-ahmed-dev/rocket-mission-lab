[package]
title = "Rocket Mission Lab RTX viewport"
version = "1.0.0"
description = "Native RTX, PhysX, camera and USD inspection without unrelated robotics tools"

[dependencies]
"isaacsim.core.api" = {}
"isaacsim.core.prims" = {}
"isaacsim.core.version" = {}
"omni.kit.loop-isaac" = {}
"omni.kit.renderer.core" = {}
"omni.hydra.rtx" = {}
"omni.isaac.ml_archive" = { order = -100 }
"omni.pip.compute" = {}
"omni.kit.mainwindow" = {}
"omni.kit.viewport.window" = {}
"omni.kit.viewport.utility" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.window.toolbar" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.property" = {}

[settings.app]
name = "Rocket Mission Lab"
version = "1.0.0"
settings.persistent = false
asyncRendering = false
enableDeveloperWarnings = false
useFabricSceneDelegate = true
gatherRenderResults = true
runLoops.main.rateLimitEnabled = false
runLoops.main.manualModeEnabled = true
events.qualifiedNames = true
window.title = "Rocket Mission Lab | Native PhysX and RTX"
window.hideUi = false

[settings]
renderer.asyncInit = true
renderer.gpuEnumeration.glInterop.enabled = false
rtx.hydra.mdlMaterialWarmup = true
exts."omni.kit.renderer.core".present.enabled = false
"/app/player/useFixedTimeStepping" = false
"/app/file/ignoreUnsavedOnExit" = true
"/physics/updateToUsd" = true
"/physics/updateVelocitiesToUsd" = false
